# 환경변수 템플릿 — 이 파일은 git에 커밋됩니다. 실제 키는 절대 넣지 마세요.
# 사용법: cp .env.example .env.local  후 .env.local 에서 값을 바꾸세요.

# ── Ollama (로컬 LLM) ──────────────────────────────────
# 선택. 비워두면 http://localhost:11434  (이 앱이 접속할 주소)
OLLAMA_HOST=http://localhost:11434

# 선택. 비워두면 qwen3.8:27b-mlx  (목록 확인: ollama list)
OLLAMA_MODEL=qwen3.8:27b-mlx
