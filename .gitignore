# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# env files — 실제 키가 들어가는 파일은 모두 제외, 템플릿(.env.example)만 커밋
.env*
!.env.example

# secrets / certificates
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local chat CSV storage
/chats/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code 개인 설정 (팀 공유용 .claude/settings.json 은 커밋)
.claude/settings.local.json
